{
  "name": "gentle-office",
  "version": "0.1.0",
  "description": "A live pixel-art office for your Pi coding-agent sessions, served on loopback with zero dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "MataM15",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MataM15/gentle-office.git"
  },
  "homepage": "https://github.com/MataM15/gentle-office#readme",
  "bugs": {
    "url": "https://github.com/MataM15/gentle-office/issues"
  },
  "keywords": ["pi", "coding-agent", "pixel-art", "sse", "gentle-ai"],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gentle-office": "src/server.mjs"
  },
  "files": [
    "src/",
    "public/",
    "extensions/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "docs/"
  ],
  "scripts": {
    "start": "node src/server.mjs",
    "hub": "node src/server.mjs --hub",
    "test": "node --test 'test/*.test.mjs'",
    "render:frames": "node scripts/render-frames.mjs",
    "capture:layout": "node scripts/capture-layout.mjs"
  }
}
